{
  "include": ["env.d.ts", "src-script/**/*", "src/types/*.d.ts"],
  "exclude": [],

  "compilerOptions": {
    "lib": ["ESNext", "DOM"],
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "@themes/*": ["./src-script/ksphinx/themes/*"],
      "@ksphinx/*": ["./src-script/ksphinx/themes/ksphinx/static/*"]
    }
  }
}
